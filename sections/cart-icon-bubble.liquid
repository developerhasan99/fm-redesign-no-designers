{%- comment -%} Same bag icon as sections/header.liquid (re-rendered after every cart change; stroke = currentColor, so it follows the header colour scheme) {%- endcomment -%}
{%- render 'pm-icon', icon: 'bag', size: 24, stroke: 1.5, class: 'icon icon-cart' -%}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- capture cart_count -%}{% render 'cart-count' %}{%- endcapture -%}
{%- assign cart_count = cart_count | plus: 0 -%}
{%- if cart_count > 0 -%}
  <div class="cart-count-bubble">
    {%- if cart_count < 100 -%}
      <span aria-hidden="true">{{ cart_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart_count }}</span>
  </div>
{%- endif -%}