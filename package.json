{
  "name": "fm-redesign-no-designers",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i src/tailwind.css -o assets/tailwind-compiled.css --postcss --minify",
    "dev": "tailwindcss -i src/tailwind.css -o assets/tailwind-compiled.css --postcss --watch",
    "serve": "shopify theme dev --store=globisoft.myshopify.com"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "postcss-rem-to-pixel": "4.1.2",
    "tailwindcss": "3.4.17"
  }
}
