{%- comment -%}
  Gift wrap add-on: product "presentinslagning", one per order. One row for both places: product image, name + price,
  toggle switch on the right (a native checkbox with role="switch"; the whole row is its label).
  - default: cart drawer footer. The wrap's own line is hidden from the drawer list (snippets/cart-drawer.liquid).
    data-fix keeps it consistent: quantity above 1 goes back to 1, and the wrap is removed when it is the only thing
    left in the cart.
  - pdp: true: product page, under the buy button, before the payment icons.
  The switch is drawn on a span next to a visually hidden checkbox, so theme/Tailwind input styles can't reach it.
  Logic in assets/gift-wrap.js; goal bars leave its price out via window.giftWrapCents (layout/theme.liquid).
{%- endcomment -%}
{%- liquid
  assign gw_product = all_products['presentinslagning']
  assign gw_variant = gw_product.selected_or_first_available_variant
  assign gw_image = gw_variant.image | default: gw_product.featured_image
  assign gw_qty = 0
  if gw_variant
    assign gw_qty = cart | item_count_for_variant: gw_variant.id
  endif
  assign gw_fix = ''
  if gw_qty > 0 and cart.item_count == gw_qty
    assign gw_fix = 0
  elsif gw_qty > 1
    assign gw_fix = 1
  endif
-%}
{%- capture gw_row -%}
  <label class="gift-wrap__row">
    {%- if gw_image -%}
      {{ gw_image | image_url: width: 120 | image_tag: class: 'gift-wrap__img', width: 56, height: 56, alt: '', loading: 'lazy' }}
    {%- endif -%}
    <span class="gift-wrap__text">
      <span class="gift-wrap__title">Presentinslagning</span>
      <span class="gift-wrap__price">Lägg till för +{{ gw_variant.price | money }}</span>
    </span>
    <input
      type="checkbox"
      role="switch"
      class="gift-wrap__input"
      aria-label="Lägg till presentinslagning"
      {% if gw_qty > 0 %}checked{% endif %}
    >
    <span class="gift-wrap__switch" aria-hidden="true"></span>
  </label>
{%- endcapture -%}

{%- if pdp -%}
  {%- if gw_variant.available -%}
    <gift-wrap-pdp class="gift-wrap gift-wrap--pdp" data-variant="{{ gw_variant.id }}">
      {{ gw_row }}
    </gift-wrap-pdp>
  {%- endif -%}
{%- elsif gw_variant.available or gw_qty > 0 -%}
  <gift-wrap class="gift-wrap" data-variant="{{ gw_variant.id }}"{% if gw_fix != '' %} data-fix="{{ gw_fix }}"{% endif %}>
    {{ gw_row }}
  </gift-wrap>
{%- endif -%}
