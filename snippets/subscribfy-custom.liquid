{%- assign exm_product_subscription_in_cart = 0 -%}
{%- if cart.item_count > 0 -%}
  {%- for item in cart.items -%}
    {% comment %} skip if vip membership or Elite montly box {% endcomment %}
    {% if item.product.variants[0].id == shop.metafields.exison.exison_plan_settings.product_variant_id
      or item.product.variants[0].id == shop.metafields.exison.exison_plan_settings2.product_variant_id
    %}
      {% continue %}
    {% endif %}

    {% if item.selling_plan_allocation.selling_plan.id %}
      {% assign exm_product_subscription_in_cart = 1 %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign customer_subscription1 = customer.metafields.exison.customer_subscription1 -%}
{%- assign customer_subscription2 = customer.metafields.exison.customer_subscription2 -%}

{%- assign exm_vip_variant_id = shop.metafields.exison.exison_plan_settings.product_variant_id -%}
{%- if exm_vip_variant_id != blank -%}
  {%- style -%}
    .cart-item[data-variant-id="{{ exm_vip_variant_id }}"] {
      display: none;
    }
  {%- endstyle -%}
{%- endif -%}

{%- unless customer -%}
  {%- style -%}
    .exison-widget__Container {
      border: none;
    }
  {%- endstyle -%}
{%- endunless -%}

<script>
  const EXM_IS_CART_PAGE = {% if template.name == 'cart' %}true{% else %}false{% endif %};
  const EXM_IS_ACTIVE_MEMBER = {% if customer_subscription1.status == 'ACTIVE' or customer_subscription2.status == 'ACTIVE' %}true{% else %}false{% endif %};
  const EXM_PAYG_IN_CART = {% if exm_product_subscription_in_cart == 1 %}true{% else %}false{% endif %};
  var EXM_VIP_INFO_LABEL = {{ 'Läs mer om ' | append: shop.name | append: '+-medlemskapet' | escape | json }};
  var EXM_VIP_VARIANT_ID = '{{ shop.metafields.exison.exison_plan_settings.product_variant_id }}';
  var EXM_VIP_PLAN_ID = '{{ shop.metafields.exison.exison_plan_settings.plan_id }}';
  var EXM_CART_URL = {{ routes.cart_url | json }};
</script>
{%- comment -%} Not deferred on purpose: it wraps window.fetch for the Subscribfy app script, so it must run where it always did. {%- endcomment -%}
<script src="{{ 'subscribfy-custom.js' | asset_url }}"></script>

{%- assign exm_plan_settings = shop.metafields.exison.exison_plan_settings -%}
{%- capture exm_popup_price -%}{% render 'subscribfy-price-converted', price: exm_plan_settings.product_price %}{%- endcapture -%}
{%- assign exm_popup_discount = exm_plan_settings.dv | round -%}

{%- comment -%}
  Trial price of the first month, from the plan's ft_price converted for the market — the same
  value the cart widget disclaimer prints. Blank when the plan has no trial fee.
{%- endcomment -%}
{%- assign exm_popup_first_month = '' -%}
{%- if exm_plan_settings.ft == '1' and exm_plan_settings.ft_price != blank -%}
  {%- assign exm_ft_price_value = exm_plan_settings.ft_price | times: 1.0 -%}
  {%- if exm_ft_price_value > 0 -%}
    {%- capture exm_popup_first_month -%}{% render 'subscribfy-credit-converted', amount: exm_plan_settings.ft_price %}{%- endcapture -%}
    {%- assign exm_popup_first_month = exm_popup_first_month | strip -%}
  {%- endif -%}
{%- endif -%}

{%- assign exm_popup_trial_fallback = '20,95 kr' -%}
{%- if cart.currency.iso_code == 'EUR' -%}
  {%- assign exm_popup_trial_fallback = '1,95 €' -%}
{%- endif -%}

{%- comment -%}
  Tier rows. Real plan rules when the discount scale is on (ds = 1), otherwise the labels below.
  Edit these two lines to change the fallback copy.
{%- endcomment -%}
{%- assign exm_popup_has_tiers = false -%}
{%- if exm_plan_settings.ds == '1' and exm_plan_settings.ds_info.rules != blank -%}
  {%- assign exm_popup_has_tiers = true -%}
{%- endif -%}
{%- assign exm_popup_tier_labels = 'Köp 1&ndash;2 varor|Köp 3&ndash;5 varor|Köp 6+ varor' | split: '|' -%}
{%- assign exm_popup_tier_values = '10|25|30' | split: '|' -%}

{%- if exm_plan_settings.plan_id > 0 -%}
<div class="exm_dialog-collection" style="display:none;">
  <div class="exm_dialog-dialog dialog-default" id="exm_dialog_1" style="z-index: 1;">
    <div class="exm_dialog-overlay">&nbsp;</div>
    <div class="exm_dialog-inner">
      <div class="exm_dialog-content">
        <div class="exm-main-content_container">
          <div class="exm_heading">
            <div class="exm-header">Tryscent<span class="exm-header-plus">+</span></div>
            <div class="exm_subtitle">VIP-medlemskap</div>
          </div>
          <button type="button" class="exm_clr-button exm_dialog-close" title="Stäng">
            <svg width="25" height="25" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g clip-path="url(#clip0_65_2009)">
                <path d="M10.8295 21.118C16.5117 21.118 21.118 16.5117 21.118 10.8295C21.118 5.14733 16.5117 0.541016 10.8295 0.541016C5.14733 0.541016 0.541016 5.14733 0.541016 10.8295C0.541016 16.5117 5.14733 21.118 10.8295 21.118Z" fill="none"/>
                <path d="M6.49799 6.49805L15.162 15.162M6.49799 15.162L15.162 6.49805" stroke="#f7f7f7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
              <defs>
                <clipPath id="clip0_65_2009">
                  <rect width="21.66" height="21.66" fill="white"/>
                </clipPath>
              </defs>
            </svg>
          </button>
          <div class="exm_dialog-content__body">
            <div class="exm_dialog-section-title">Köp mer, spara mer</div>

            <div class="exm_dialog-description">
              {%- if exm_popup_first_month != blank -%}
                Endast <b>{{ exm_popup_first_month }}</b> för första månaden, sedan <b>{{ exm_popup_price }}</b> per månad som blir till butikskredit.
              {%- else -%}
                Endast <b>{{ exm_popup_trial_fallback }}</b> för första månaden, sedan <b>{{ exm_popup_price }}</b> per månad som blir till butikskredit.
              {%- endif -%}
            </div>

            <div class="exm-tiers">
              {%- if exm_popup_has_tiers -%}
                {%- for rule in exm_plan_settings.ds_info.rules -%}
                  {%- assign exm_tier_from = rule.ds_cart_amount | round -%}
                  {%- assign exm_tier_next_index = forloop.index -%}
                  {%- capture exm_tier_label -%}
                    {%- if exm_plan_settings.ds_info.discount_rule_type == 'items' -%}
                      {%- if forloop.last -%}
                        Köp {{ exm_tier_from }}+ varor
                      {%- else -%}
                        {%- assign exm_tier_to = exm_plan_settings.ds_info.rules[exm_tier_next_index].ds_cart_amount | round | minus: 1 -%}
                        {%- if exm_tier_to > exm_tier_from -%}
                          Köp {{ exm_tier_from }}&ndash;{{ exm_tier_to }} varor
                        {%- else -%}
                          Köp {{ exm_tier_from }} vara
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if forloop.last -%}
                        Handla för {{ exm_tier_from | times: 100 | money_without_trailing_zeros }}+
                      {%- else -%}
                        {%- assign exm_tier_to = exm_plan_settings.ds_info.rules[exm_tier_next_index].ds_cart_amount | round | minus: 1 -%}
                        Handla för {{ exm_tier_from | times: 100 | money_without_trailing_zeros }}&ndash;{{ exm_tier_to | times: 100 | money_without_trailing_zeros }}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endcapture -%}

                  <div class="exm-tier{% if forloop.last %} exm-tier--top{% endif %}">
                    <span class="exm-tier-label">{{ exm_tier_label | strip }}</span>
                    <span class="exm-tier-value">{{ rule.ds_value | round }} % RABATT</span>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for label in exm_popup_tier_labels -%}
                  <div class="exm-tier{% if forloop.last %} exm-tier--top{% endif %}">
                    <span class="exm-tier-label">{{ label }}</span>
                    <span class="exm-tier-value">{{ exm_popup_tier_values[forloop.index0] }} % RABATT</span>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>

            <div class="exm-plan-items">
              <div class="exm-plan-item">
                <svg class="exm-plan-item-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 0.90625C6.61553 0.90625 5.26216 1.31679 4.11101 2.08596C2.95987 2.85513 2.06266 3.94838 1.53285 5.22747C1.00303 6.50655 0.86441 7.91402 1.13451 9.27188C1.4046 10.6298 2.07129 11.877 3.05026 12.856C4.02922 13.835 5.2765 14.5017 6.63437 14.7717C7.99224 15.0418 9.39971 14.9032 10.6788 14.3734C11.9579 13.8436 13.0511 12.9464 13.8203 11.7952C14.5895 10.6441 15 9.29072 15 7.90625C15 6.04974 14.2625 4.26926 12.9498 2.9565C11.637 1.64375 9.85652 0.90625 8 0.90625ZM7 10.7013L4.5 8.20125L5.295 7.40625L7 9.11125L10.705 5.40625L11.503 6.19925L7 10.7013Z" fill="#424242"/></svg>
                <div class="exm-plan-item-description">{{ exm_popup_price }} i månatlig butikskredit</div>
              </div>

              <div class="exm-plan-item">
                <svg class="exm-plan-item-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 0.90625C6.61553 0.90625 5.26216 1.31679 4.11101 2.08596C2.95987 2.85513 2.06266 3.94838 1.53285 5.22747C1.00303 6.50655 0.86441 7.91402 1.13451 9.27188C1.4046 10.6298 2.07129 11.877 3.05026 12.856C4.02922 13.835 5.2765 14.5017 6.63437 14.7717C7.99224 15.0418 9.39971 14.9032 10.6788 14.3734C11.9579 13.8436 13.0511 12.9464 13.8203 11.7952C14.5895 10.6441 15 9.29072 15 7.90625C15 6.04974 14.2625 4.26926 12.9498 2.9565C11.637 1.64375 9.85652 0.90625 8 0.90625ZM7 10.7013L4.5 8.20125L5.295 7.40625L7 9.11125L10.705 5.40625L11.503 6.19925L7 10.7013Z" fill="#424242"/></svg>
                <div class="exm-plan-item-description">Tidig tillgång till nya släpp</div>
              </div>

              <div class="exm-plan-item">
                <svg class="exm-plan-item-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 0.90625C6.61553 0.90625 5.26216 1.31679 4.11101 2.08596C2.95987 2.85513 2.06266 3.94838 1.53285 5.22747C1.00303 6.50655 0.86441 7.91402 1.13451 9.27188C1.4046 10.6298 2.07129 11.877 3.05026 12.856C4.02922 13.835 5.2765 14.5017 6.63437 14.7717C7.99224 15.0418 9.39971 14.9032 10.6788 14.3734C11.9579 13.8436 13.0511 12.9464 13.8203 11.7952C14.5895 10.6441 15 9.29072 15 7.90625C15 6.04974 14.2625 4.26926 12.9498 2.9565C11.637 1.64375 9.85652 0.90625 8 0.90625ZM7 10.7013L4.5 8.20125L5.295 7.40625L7 9.11125L10.705 5.40625L11.503 6.19925L7 10.7013Z" fill="#424242"/></svg>
                <div class="exm-plan-item-description">VIP-support</div>
              </div>
            </div>

            <div class="exm-select-mem">
              {%- if exm_popup_first_month != blank -%}
                Välj &rsquo;Gå med i VIP&rsquo; i varukorgen för att bli medlem för endast {{ exm_popup_first_month }}. Du kan pausa eller avsluta när som helst.
              {%- else -%}
                Välj &rsquo;Gå med i VIP&rsquo; i varukorgen för att bli medlem för endast {{ exm_popup_trial_fallback }}. Du kan pausa eller avsluta när som helst.
              {%- endif -%}
            </div>

            <div class="exm_continue_shopping">
              <a href="javascript:;" class="exm_dialog-learn-more">Fortsätt handla</a>
            </div>

            <a class="exm_dialog-membership-link" href="{{ pages['membership'].url | default: '/pages/membership' }}">Läs mer om Tryscent+-medlemskapet</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}
