      media="all">


    {%- comment -%}
      Swiper 11.2.10, self-hosted (was jsDelivr: one less origin to connect to). Loaded up front only when the page
      content has a slider; anything else (the mobile menu slider in snippets/header-drawer.liquid) calls
      window.pmLoadSwiper(), which loads it once on demand.
    {%- endcomment -%}
    {%- if content_for_layout contains 'swiper' -%}
      <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}</noscript>
      <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script>
      window.pmLoadSwiper = function () {
        if (window.Swiper) return Promise.resolve(window.Swiper);
        return (window.pmSwiperLoading = window.pmSwiperLoading || new Promise(function (resolve, reject) {
          if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
            var css = document.createElement('link');
            css.rel = 'stylesheet';
            css.href = {{ 'swiper-bundle.min.css' | asset_url | json }};
            document.head.appendChild(css);
          }
          var js = document.querySelector('script[src*="swiper-bundle.min.js"]');
          if (!js) {
            js = document.createElement('script');
            js.src = {{ 'swiper-bundle.min.js' | asset_url | json }};
            document.head.appendChild(js);
          }
          js.addEventListener('load', function () { resolve(window.Swiper); });
          js.addEventListener('error', reject);
        }));
      };
    </script>

