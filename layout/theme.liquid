      {{ 'pm-frag.css' | asset_url | stylesheet_tag }}
    {%- else -%}
      <link rel="stylesheet" href="{{ 'pm-frag.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}
    <script src="{{ 'pm-frag.js' | asset_url }}" defer="defer"></script>

  </head>

  <body class="{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}">
    {{ 'subscribfy-custom-styles.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Subscribfy VIP widget is off in every market: the cart widget is gone from the drawer and
      cart page, and the product page app blocks are disabled in the templates (hidden here too,
      in case one is re-added in the editor).
      Denmark also has the membership page and Subscribfy scripts off, and a VIP line carried
      over from another market is removed from the cart.
    {%- endcomment -%}
    <style>
      [id*='__subscribfy_'],
      .exm_dialog-collection {
        display: none !important;
      }
    </style>
    {%- if localization.country.iso_code == 'DK' -%}
      {%- if template.suffix == 'membership-landing' -%}
        <script>location.replace({{ routes.root_url | json }});</script>
        <meta http-equiv="refresh" content="0; url={{ routes.root_url }}">
      {%- endif -%}
      {%- liquid
        assign exm_vip_variant_key = shop.metafields.exison.exison_plan_settings.product_variant_id | append: ''
        assign exm_plan2_variant_key = shop.metafields.exison.exison_plan_settings2.product_variant_id | append: ''
        assign exm_vip_line_key = ''
        for item in cart.items
          assign exm_item_key = item.variant_id | append: ''
          if exm_item_key == exm_vip_variant_key or exm_item_key == exm_plan2_variant_key
            assign exm_vip_line_key = item.key
            break
          endif
        endfor
      -%}
      {%- if exm_vip_line_key != blank -%}
        <script>
          fetch({{ routes.cart_change_url | append: '.js' | json }}, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: {{ exm_vip_line_key | json }}, quantity: 0 }),
          }).then(function(response){
            if (response.ok) {
              location.reload();
            }
          });
        </script>
      {%- endif -%}
    {%- endif -%}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {%- comment -%}
      FM look for the header group only (top bar + header): pm-header.css and pm-s-offer-timebar.css apply under .premium.
      display: contents keeps the sticky header attached to <body>. Cart drawer, main content and footer stay outside.
    {%- endcomment -%}
    <div class="premium" style="display: contents;">
    {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout focus-none"
      role="main"
      tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      // Gift wrap (snippets/gift-wrap.liquid) counts toward no offer: goal bars take its price out of the cart total.
      window.giftWrapCents = function (c) {
        return ((c && c.items) || []).reduce(function (s, i) {
          return s + (i.handle === 'presentinslagning' ? Number(i.final_line_price) || 0 : 0);
        }, 0);
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script>
      /* SEO 2026-11-03: AddShoppers loads after the page has finished loading */
      window.addEventListener('load', function() {
        setTimeout(function() {
          var script = document.createElement('script');
          script.id = 'minty-onsite-script';
          script.src = 'https://cdn.addshoppers.com/minty/shopify-onsite/executeminty.js';
          script.async = true;
          document.head.appendChild(script);
        }, 1500);
      });
    </script>

    {% comment %} SEO 2026-11-03: removed unused Google News script (news.google.com/swg) {% endcomment %}
  {% comment %} {% render 'navidium-script' %} {% endcomment %}
  {% comment %} {% render 'sb-preload-booster' %}  {% endcomment %}
  {% comment %} {% render 'checkout-modal' %} {% endcomment %}

  {%- comment -%}
    FUEL_06 finder dialog on product pages, opened by the link under the buy
    button (snippets/fuel06-pdp-link.liquid). Here rather than in a section
    because the product templates are at Shopify's 25 section cap. The link
    stays hidden on any page where this dialog is not rendered.
  {%- endcomment -%}
  {%- if request.page_type == 'product' and settings.fuel06_pdp_enabled -%}
    {%- render 'fuel06-finder', mode: 'assets' -%}
    {%- render 'fuel06-finder', mode: 'dialog' -%}
  {%- endif -%}

  {%- if settings.enable_scent_quiz -%}
    {%- comment -%} The popup opens only from its floating button or auto-open; with both off it has no way in, so skip it. {%- endcomment -%}
    {%- if settings.scent_quiz_show_floating_button or settings.scent_quiz_auto_open_delay > 0 -%}
      {%- render 'scent-quiz-popup' -%}
    {%- endif -%}
    {%- assign scent_quiz_bundle_product = settings.scent_quiz_bundle_product | default: all_products['6x-50ml-perfume-bottles'] -%}
    {%- if request.page_type == 'product' and product.id == scent_quiz_bundle_product.id -%}
      {%- render 'quiz-bundle-prefill' -%}
    {%- endif -%}
  {%- endif -%}
    {%- comment -%} Not deferred: it wraps window.fetch/XHR, so it must run before cart callers, in every market. {%- endcomment -%}
    <script src="{{ 'cart-url-locale.js' | asset_url }}"></script>
    {%- unless localization.country.iso_code == 'DK' -%}
      {% render 'subscribfy-custom' %}
    {%- endunless -%}
    {% render 'price-test-card-sync' %}
    {% render 'pm-frag-texts' %}
    {%- comment -%} script-subscribify.js is loaded by the Subscribfy app embed; a second copy here ran it twice. {%- endcomment -%}
    {% render 'bundle-cart-guard' %}
  </body>
</html>